# HTTP server
PORT=8080
WEBHOOK_SECRET=replace-me
DATABASE_URL=file:reviewagent.db?_pragma=busy_timeout(5000)&_pragma=journal_mode(WAL)
# Required to access GET /runs/{id} when the service is deployed.
ADMIN_TOKEN=

# GitHub API. A fine-grained token is enough for local development; replace this
# with GitHub App installation-token authentication before production use.
GITHUB_TOKEN=

# Optional OpenAI-compatible API. Without these values, the service runs in
# dry-run mode and validates the pipeline without publishing model findings.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini

# Review policy
MIN_CONFIDENCE=0.75
MAX_FILES=20
MAX_PATCH_LINES=1200
